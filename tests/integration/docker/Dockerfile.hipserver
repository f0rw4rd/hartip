# FieldComm HART-IP Developer Kit (hipserver + hipflowapp), HART-IP v1.
# Official implementation from FieldComm Group (Apache-2.0), built from
# source at pinned commits:
#   https://github.com/FieldCommGroup/hipserver
#   https://github.com/FieldCommGroup/hipflowapp

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    git \
    libssl-dev \
    libjsoncpp-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone hipflowapp (without submodules - we'll use main hipserver)
WORKDIR /src
# Pin to specific commits for reproducibility (no moving HEAD).
RUN git clone https://github.com/FieldCommGroup/hipflowapp.git && \
    git -C hipflowapp checkout 1c5b22112b95f4e7e14cb62539c3806f98040c1e

# Clone main hipserver repo (has factory_reset.o and full Server files)
RUN git clone https://github.com/FieldCommGroup/hipserver.git && \
    git -C hipserver checkout 8c5b565a93c3bb50a8eec47df62d2b3ea2edd45c

# Remove submodule placeholder and replace with full hipserver
RUN rm -rf /src/hipflowapp/hipflowapp/Hip_Native/hipserver && \
    cp -r /src/hipserver /src/hipflowapp/hipflowapp/Hip_Native/hipserver

# Build hipserver first
WORKDIR /src/hipflowapp/hipflowapp/Hip_Native/hipserver/hipserver/Server
RUN make clean 2>/dev/null || true && make

# Build hipflowapp
WORKDIR /src/hipflowapp/hipflowapp/Hip_Native
RUN make clean 2>/dev/null || true && make

# Runtime image
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    libjsoncpp25 \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy binaries from builder
COPY --from=builder /src/hipflowapp/hipflowapp/Hip_Native/hipserver/hipserver/Server/hipserver /app/
COPY --from=builder /src/hipflowapp/hipflowapp/Hip_Native/hipflowapp /app/

# Note: No config files needed - hipserver/hipflowapp work without JSON configs

# Create startup script
RUN echo '#!/bin/bash\n\
echo "========================================"\n\
echo "HART-IP Server (FieldComm hipserver)"\n\
echo "  Port: ${HART_UDP_PORT:-5094} (UDP + TCP)"\n\
echo "========================================"\n\
exec /app/hipserver -p ${HART_UDP_PORT:-5094} /app/hipflowapp\n\
' > /app/start.sh && chmod +x /app/start.sh

# Expose HART-IP ports
EXPOSE 5094/udp
EXPOSE 5094/tcp

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s \
    CMD nc -zu localhost 5094 || exit 1

CMD ["/app/start.sh"]
